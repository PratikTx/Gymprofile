# Copy this file to .env and fill in real values. Never commit .env itself.

PORT=1000

# MongoDB Atlas connection string (was previously hardcoded in Model/User.js)
MONGO_URI=mongodb+srv://pratikchindhe44:pratik123@cluster0.z8syx.mongodb.net/Dfitness

# Long random string, e.g. generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# Shared login password members use today (was hardcoded as "mygym" in index.js)
DEFAULT_LOGIN_PASSWORD=mygym

# Shared secret for the optional POST /api/admin/broadcast route ("x-admin-key" header)
ADMIN_API_KEY=replace_this_with_a_long_random_string

# Comma-separated list of allowed browser origins (your Vite app, admin dashboard, etc)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost,https://localhost

# Redis connection (local dev default shown; use your managed Redis URL in production)
REDIS_URL=rediss://default:gQAAAAAAAUGVAAIgcDI3ZDJmNTc0NzkyNGM0Y2M0YTMwYTUzNjZjZDQyY2MwYQ@main-caiman-82325.upstash.io:6379

# Path to the Firebase service account JSON (Firebase Console -> Project Settings -> Service Accounts)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# How often (ms) the notification watcher polls Mongo for new/unsent notifications.
# Lower = faster delivery, more DB load. 10000 (10s) is a reasonable default.
NOTIFICATION_POLL_INTERVAL_MS=10000
